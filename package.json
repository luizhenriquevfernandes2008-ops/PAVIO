{
  "name": "pavio",
  "productName": "PAVIO",
  "version": "1.0.0",
  "description": "PAVIO - roguelite 2D de uma velinha na masmorra (WW STUDIOS)",
  "author": "Luiz Vargas (WW STUDIOS)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "doc": "node scripts/doc.mjs",
    "gerar": "node scripts/gerarConteudo.mjs",
    "app": "vite build && electron .",
    "icone": "node scripts/icone.mjs",
    "dist": "tsc --noEmit && vite build && electron-builder --win nsis --x64 --publish never",
    "dist:pasta": "tsc --noEmit && vite build && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "phaser": "^3.90.0"
  },
  "build": {
    "appId": "com.wwstudios.pavio",
    "productName": "PAVIO",
    "copyright": "WW STUDIOS · Luiz Vargas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PAVIO-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PAVIO",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1046"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
